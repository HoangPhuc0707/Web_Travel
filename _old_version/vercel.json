{
  "version": 2,
  "name": "ptx-travel",
  "buildCommand": "",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/tours",        "destination": "/tours.html" },
    { "source": "/tour/:id",     "destination": "/tour-detail.html" },
    { "source": "/destinations", "destination": "/destinations.html" },
    { "source": "/about",        "destination": "/about.html" },
    { "source": "/blog",         "destination": "/blog.html" },
    { "source": "/blog/:id",     "destination": "/blog-detail.html" },
    { "source": "/contact",      "destination": "/contact.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
